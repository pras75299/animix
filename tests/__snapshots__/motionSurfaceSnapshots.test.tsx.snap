exports[`motion surface snapshots > matches the surface motion contract snapshots 1`] = `
{
  "drawer": ".animix-drawer-in-right {
animation: animix-drawer-in-right var(--animix-duration-slow, 280ms) var(--animix-ease-out) both;
}",
  "listItemEntrance": ".animix-in-fade {
animation-name: animix-fade-in;
  animation-duration: var(--animix-duration-base, 300ms);
  animation-timing-function: var(--animix-ease-out, cubic-bezier(0, 0, 0.2, 1));
  animation-delay: var(--animix-delay, 0ms);
  animation-fill-mode: var(--animix-fill-mode, both);
  animation-iteration-count: var(--animix-iteration, 1);
}",
  "modal": ".animix-modal-in {
animation: animix-modal-in var(--animix-duration-base, 240ms) var(--animix-ease-out) both;
  transform-origin: center center;
}",
  "staggerContainer": ".animix-stagger > * {
animation-delay: calc(var(--animix-stagger-delay, 75ms) * var(--animix-stagger-index, 0));
}",
  "staggerFirstItem": ".animix-stagger > *:nth-child(1) {
--animix-stagger-index: 0;
}",
  "staggerSecondItem": ".animix-stagger > *:nth-child(2) {
--animix-stagger-index: 1;
}",
  "staggerThirdItem": ".animix-stagger > *:nth-child(3) {
--animix-stagger-index: 2;
}",
  "toast": ".animix-toast-in-right {
animation: animix-toast-in-right var(--animix-duration-base, 240ms) var(--animix-ease-out) both;
}",
  "tooltip": ".animix-tooltip-in {
animation: animix-tooltip-in var(--animix-duration-fast, 180ms) var(--animix-ease-out) both;
  transform-origin: var(
    --radix-popover-content-transform-origin,
    var(--transform-origin, var(--animix-transform-origin, center center))
  );
}",
}
`;
