exports[`motion surface snapshots > matches reduced-motion end-state snapshots 1`] = `
{
  "drawerEndState": "animix-drawer-in-right to {
transform: translateX(0);
}",
  "listItemEndState": "animix-fade-in to {
opacity: 1;
}",
  "modalEndState": "animix-modal-in to {
opacity: 1;
    transform: scale(1);
}",
  "reducedMotionTokens": "@media (prefers-reduced-motion: reduce) {
  :root {
--animix-duration-micro: 0ms;
    --animix-duration-fast: 0ms;
    --animix-duration-base: 0ms;
    --animix-duration-slow: 0ms;
    --animix-duration-slower: 0ms;
    --animix-delay: 0ms;
    --animix-stagger-delay: 0ms;
    --animix-motion-intensity: 0;
  }
}",
  "toastEndState": "animix-toast-in-right to {
opacity: 1;
    transform: translateX(0);
}",
  "tooltipEndState": "animix-tooltip-in to {
opacity: 1;
    transform: scale(1);
}",
}
`;

