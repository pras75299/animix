{
  "name": "@pras75299/animix",
  "version": "0.2.1",
  "description": "Production-ready CSS animation library for Tailwind CSS v3/v4, React, and shadcn/ui — zero runtime by default, reduced-motion safe.",
  "author": "animix contributors",
  "license": "MIT",
  "keywords": [
    "animation",
    "css",
    "tailwind",
    "tailwindcss",
    "shadcn",
    "shadcn-ui",
    "react",
    "radix-ui",
    "keyframes",
    "motion",
    "transitions",
    "css-animation",
    "framer-motion-alternative",
    "reduced-motion",
    "ui",
    "design-system"
  ],
  "homepage": "https://github.com/pras75299/animix#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pras75299/animix.git"
  },
  "bugs": {
    "url": "https://github.com/pras75299/animix/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=18"
  },
  "sideEffects": [
    "*.css",
    "./src/index.css",
    "./src/tokens.css",
    "./src/utilities.css",
    "./src/animations/*.css",
    "./shadcn-presets.css"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./tailwind": {
      "types": "./dist/tailwind/plugin.d.ts",
      "import": "./dist/tailwind/plugin.js",
      "require": "./dist/tailwind/plugin.cjs"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js",
      "require": "./dist/react/index.cjs"
    },
    "./classes": {
      "types": "./dist/classes.d.ts",
      "import": "./dist/classes.js",
      "require": "./dist/classes.cjs"
    },
    "./css": "./src/index.css",
    "./css/tokens": "./src/tokens.css",
    "./css/entrance": "./src/animations/entrance.css",
    "./css/exit": "./src/animations/exit.css",
    "./css/attention": "./src/animations/attention.css",
    "./css/loaders": "./src/animations/loaders.css",
    "./css/icons": "./src/animations/icons.css",
    "./css/text": "./src/animations/text.css",
    "./css/images": "./src/animations/images.css",
    "./css/transitions": "./src/animations/transitions.css",
    "./css/modern": "./src/animations/modern.css",
    "./css/view-transitions": "./src/animations/view-transitions.css",
    "./css/utilities": "./src/utilities.css",
    "./shadcn": "./shadcn-presets.css"
  },
  "files": [
    "dist",
    "src",
    "shadcn-presets.css",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "build:watch": "tsup --watch",
    "dev": "cd playground && vite",
    "build:playground": "cd playground && vite build",
    "dev:docs": "vite --config docs/vite.config.ts",
    "build:docs": "vite build --config docs/vite.config.ts",
    "preview:docs": "vite preview --config docs/vite.config.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p playground/tsconfig.json && tsc --noEmit -p docs/tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,css,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,css,json,md}\"",
    "test": "node scripts/check-tailwind-keyframes.mjs",
    "prepare": "husky",
    "prepublishOnly": "npm run build && npm run typecheck && npm run lint && npm test"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "tailwindcss": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "tailwindcss": {
      "optional": true
    }
  },
  "devDependencies": {
    "@commitlint/cli": "^19.3.0",
    "@commitlint/config-conventional": "^19.2.2",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.13.0",
    "@typescript-eslint/parser": "^7.13.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.7",
    "postcss": "^8.4.38",
    "prettier": "^3.3.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vite": "^5.4.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css}": [
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "tsup": {
    "entry": {
      "index": "src/index.ts",
      "classes": "src/classes.ts",
      "tailwind/plugin": "tailwind/plugin.ts",
      "react/index": "react/index.ts"
    },
    "format": [
      "cjs",
      "esm"
    ],
    "dts": true,
    "sourcemap": false,
    "clean": true,
    "treeshake": true,
    "minify": false,
    "external": [
      "react",
      "react-dom",
      "tailwindcss"
    ]
  }
}
